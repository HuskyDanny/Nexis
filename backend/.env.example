# =============================================================================
# Financial Agent v2 (Nexis) — Environment Variables
# Copy to .env and fill in values before running.
# =============================================================================

# --- Required in production (validated at startup) ---
NEO4J_PASSWORD=
SECRET_KEY=
SILICONFLOW_API_KEY=

# --- Environment ---
# "development" skips secret validation; "production" enforces it
ENVIRONMENT=development

# --- Database ---
MONGODB_URL=mongodb://mongodb:27017/financial_agent_v2
REDIS_URL=redis://redis:6379/0

# --- Neo4j (shared dev instance on :7690 — see docs/shared-neo4j.md) ---
# Host-run backend: localhost:7690
# Docker-compose backend: host.docker.internal:7690
NEO4J_URI=bolt://localhost:7690
NEO4J_USER=neo4j

# --- Logging ---
LOG_LEVEL=INFO
# "text" (human-readable) or "json" (structured, for log aggregation)
LOG_FORMAT=text

# --- CORS ---
# Comma-separated origins are NOT supported; use JSON list syntax in .env
# CORS_ORIGINS=["http://localhost:3000"]

# --- News API Keys (optional, enables real data) ---
ALPHA_VANTAGE_API_KEY=
PERIGON_API_KEY=
NEWSAPI_API_KEY=

# --- Rate Limits ---
# NEWSAPI_DAILY_LIMIT=100
# NEWSAPI_AGENT_DAILY_CAP=50
# PERIGON_AGENT_DAILY_CAP=2

# --- Pool Pipeline ---
# NEWS_CRON_INTERVAL_HOURS=2
# NEWS_SIMILARITY_THRESHOLD=0.75
# NEWS_MAX_AGE_DAYS=7
